# Sao chép file này thành `.env` (KHÔNG commit `.env` thật — đã có trong
# .gitignore của repo) rồi điền giá trị thật, hoặc set trực tiếp qua biến môi
# trường của môi trường deploy (systemd, Docker, ...).

# BẮT BUỘC — danh sách tài khoản, định dạng "user1:pass1,user2:pass2". Mỗi
# tài khoản có 1 thư mục lưu riêng biệt, hoàn toàn cách ly nhau. Thiết kế cho
# dùng cá nhân/nhóm nhỏ (vài người tự biết mật khẩu của nhau qua kênh riêng),
# KHÔNG có màn đăng ký/tự phục vụ.
CHESSNOTE_CLOUD_USERS=alice:doi-mat-khau-nay,bob:va-mat-khau-nay-nua

# Tuỳ chọn — cổng lắng nghe (mặc định 8080).
CHESSNOTE_CLOUD_PORT=8080

# Tuỳ chọn — thư mục gốc lưu file trên đĩa (mặc định ./data). Backup thư mục
# này = backup toàn bộ dữ liệu.
CHESSNOTE_CLOUD_DATA_DIR=./data
