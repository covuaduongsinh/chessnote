{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChessNote",
  "version": "1.2.0",
  "identifier": "com.chessnote.app",
  "build": {
    "beforeDevCommand": "npm run build:client:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../../client_bundle/client/.client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChessNote",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "copyright": "ChessNote (MIT License)",
    "shortDescription": "Personal Chess Knowledge & Study Database",
    "longDescription": "ChessNote - All-in-one Chess Knowledge & Study Base",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
