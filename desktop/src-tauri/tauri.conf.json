{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run build:client",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../client_bundle"
  },
  "package": {
    "productName": "ChessNote",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APPDATA/ChessNote/**", "$DOCUMENT/**"]
      },
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": true,
        "open": true
      },
      "dialog": {
        "all": true
      },
      "process": {
        "relaunch": true,
        "exit": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "ChessNote (MIT License)",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "bin/arasan-native"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.chessnote.app",
      "longDescription": "ChessNote - All-in-one Chess Knowledge & Study Base",
      "shortDescription": "Personal Chess Knowledge & Study Database",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 850,
        "resizable": true,
        "title": "ChessNote",
        "width": 1280
      }
    ]
  }
}
